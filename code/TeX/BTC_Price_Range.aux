\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Daily log returns coloured by regime (volatile or calm, according to the smoothed probability). The calm points have a narrow dispersion but include isolated extremes, among them the $-46.5\,\%$ of 2020-03-12. Figure labels are in French.}}{58}{figure.caption.55}\protected@file@percent }
\newlabel{fig:app-returns-regime}{{20}{58}{Daily log returns coloured by regime (volatile or calm, according to the smoothed probability). The calm points have a narrow dispersion but include isolated extremes, among them the $-46.5\,\%$ of 2020-03-12. Figure labels are in French}{figure.caption.55}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {A.5}Distribution of returns by regime}{59}{subsection.A.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Density of the returns of each regime, log scale. The calm regime has a narrow body but isolated extremes. The tails of both curves are jagged (a kernel estimate on few points) and are not interpreted. Figure labels are in French.}}{59}{figure.caption.56}\protected@file@percent }
\newlabel{fig:app-dist-regime}{{21}{59}{Density of the returns of each regime, log scale. The calm regime has a narrow body but isolated extremes. The tails of both curves are jagged (a kernel estimate on few points) and are not interpreted. Figure labels are in French}{figure.caption.56}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {A.6}Tail index}{60}{subsection.A.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Hill estimator of the tail index $\hat  \alpha $ as a function of the number $k$ of extreme observations retained, for losses (left tail) and gains (right tail); the dotted line is the $\nu $ of the fitted $t$ ($2.23$). There is \textbf  {no plateau}: for losses the estimate moves from about $4$ at small $k$ to about $1.9$ at $k=400$, and for gains from about $5$ to about $2.3$. The tail index is therefore not identified, and no single value should be quoted. The Hill estimator assumes independent observations; volatility clustering biases it, so the reading is indicative. Figure labels are in French.}}{60}{figure.caption.57}\protected@file@percent }
\newlabel{fig:app-hill}{{22}{60}{Hill estimator of the tail index $\hat \alpha $ as a function of the number $k$ of extreme observations retained, for losses (left tail) and gains (right tail); the dotted line is the $\nu $ of the fitted $t$ ($2.23$). There is \textbf {no plateau}: for losses the estimate moves from about $4$ at small $k$ to about $1.9$ at $k=400$, and for gains from about $5$ to about $2.3$. The tail index is therefore not identified, and no single value should be quoted. The Hill estimator assumes independent observations; volatility clustering biases it, so the reading is indicative. Figure labels are in French}{figure.caption.57}{}}
