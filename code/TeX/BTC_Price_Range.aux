\@writefile{toc}{\contentsline {subsection}{\numberline {A.1}Smoothed and filtered probability, March 2020}{56}{subsection.A.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Probability of the volatile regime around the shock of March 2020 (full-sample estimation): filtered (real time) and smoothed (\emph  {ex post}). The dotted line marks 2020-03-12. On that day the filtered probability is $0.521$ (it was $0.775$ the day before) and the smoothed probability $0.334$: the largest shock of the sample is attributed to the calm regime. The subtitle of the figure gives these probabilities the day before, on the day and five days after, rounded to the percent. Figure labels are in French.}}{56}{figure.caption.52}\protected@file@percent }
\newlabel{fig:app-shock-prob}{{17}{56}{Probability of the volatile regime around the shock of March 2020 (full-sample estimation): filtered (real time) and smoothed (\emph {ex post}). The dotted line marks 2020-03-12. On that day the filtered probability is $0.521$ (it was $0.775$ the day before) and the smoothed probability $0.334$: the largest shock of the sample is attributed to the calm regime. The subtitle of the figure gives these probabilities the day before, on the day and five days after, rounded to the percent. Figure labels are in French}{figure.caption.52}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {A.2}Share of volatile days by year}{57}{subsection.A.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Share of days with a smoothed volatile-regime probability above $50\,\%$, by calendar year (2014 and 2026 are partial years). The share goes up and down, from about $19\,\%$ in 2016 to $100\,\%$ in 2021, with no single step: this is the pattern expected of regimes and not of an era. It does not follow the yearly standard deviation of Table~\ref {tab:data-yearly}. Figure labels are in French.}}{57}{figure.caption.53}\protected@file@percent }
\newlabel{fig:app-yearly}{{18}{57}{Share of days with a smoothed volatile-regime probability above $50\,\%$, by calendar year (2014 and 2026 are partial years). The share goes up and down, from about $19\,\%$ in 2016 to $100\,\%$ in 2021, with no single step: this is the pattern expected of regimes and not of an era. It does not follow the yearly standard deviation of Table~\ref {tab:data-yearly}. Figure labels are in French}{figure.caption.53}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {A.3}Regime label and realised volatility}{58}{subsection.A.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Share of days labelled ``volatile'' against the realised standard deviation of the returns, by calendar year (2014 and 2026 are partial years). The Pearson correlation is $0.47$ over 13 points, a descriptive figure: with so few points it is not significantly different from zero at the 5\,\% level. The label is related to the volatility level but does not reduce to it: 2016 and 2023 have similar standard deviations ($2.5\,\%$ and $2.3\,\%$) and very different shares of volatile days ($19\,\%$ and $58\,\%$). Figure labels are in French.}}{58}{figure.caption.54}\protected@file@percent }
\newlabel{fig:app-label-vol}{{19}{58}{Share of days labelled ``volatile'' against the realised standard deviation of the returns, by calendar year (2014 and 2026 are partial years). The Pearson correlation is $0.47$ over 13 points, a descriptive figure: with so few points it is not significantly different from zero at the 5\,\% level. The label is related to the volatility level but does not reduce to it: 2016 and 2023 have similar standard deviations ($2.5\,\%$ and $2.3\,\%$) and very different shares of volatile days ($19\,\%$ and $58\,\%$). Figure labels are in French}{figure.caption.54}{}}
